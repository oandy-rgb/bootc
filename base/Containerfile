FROM ghcr.io/ublue-os/aurora-dx-nvidia-open:stable

RUN dnf install -y \
      --disablerepo="*" --enablerepo="fedora" --enablerepo="updates" \
      --setopt=zchunk=False \
      --setopt=minrate=0 \
      nodejs python3 gcc git gh htop chezmoi age nix restic rclone \
    && dnf clean all

# sops binary
RUN curl -fL -o /usr/bin/sops \
      https://github.com/getsops/sops/releases/download/v3.13.1/sops-v3.13.1.linux.amd64 \
    && chmod +x /usr/bin/sops \
    && test "$(stat -c%s /usr/bin/sops)" -gt 1000000 \
    && sops --version

# === k3s binary ===
# k3s 就是「单一执行档」——把 kubelet/containerd/flannel/etcd 全打包
# NixOS 的 services.k3s.enable 背后就是下载这个 binary
RUN curl -fL -o /usr/bin/k3s \
      https://github.com/k3s-io/k3s/releases/download/v1.31.5+k3s1/k3s \
    && chmod +x /usr/bin/k3s \
    && test "$(stat -c%s /usr/bin/k3s)" -gt 10000000 \
    && /usr/bin/k3s --version

RUN systemctl enable nix-daemon.socket

COPY overlay/ /

RUN chmod +x /usr/local/bin/backup.sh

# === enable 服务 ===
RUN systemctl enable backup.timer
RUN systemctl enable k3s.service

RUN bootc container lint
